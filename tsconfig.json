{
    "compilerOptions": {
        "target": "es6",
        "lib": ["ES2019", "DOM"],
        "module": "commonjs",
        "declaration": true,
        "types": ["node"],
        "typeRoots": ["./node_modules/@types"],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "paths": {
            "@src/*": [
                "src/*"
            ],
            "@test/*": [
                "tests/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "tests"
    ]
}
